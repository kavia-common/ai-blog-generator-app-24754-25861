# Backend API Service - Example Environment Variables
# Copy this file to .env and adjust values as needed.

# Server
BACKEND_PORT=8000

# Database
# Ensure your Postgres instance is running and accessible at this URL.
# DB name and port must match your local DB container/service.
DATABASE_URL=postgresql://appuser:dbuser123@localhost:5000/ai_blog_generator_db

# CORS - allow local frontend
CORS_ORIGINS=http://localhost:3000

# Authentication
# Generate a strong secret and set here in .env (do not commit real secret)
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# AI Provider configuration
# Provider type; code supports "openai-compatible"
AI_PROVIDER=openai-compatible
# API Key for your AI provider; if empty, app uses placeholder generation
AI_API_KEY=
# Model name to use for generation
AI_MODEL=gpt-4o-mini
# Optional: Base URL for OpenAI-compatible API (defaults to https://api.openai.com/v1 if unset)
OPENAI_BASE_URL=

# Exports
# For now PDF is a placeholder; set to 'none' to indicate disabled
PDF_ENGINE=none
