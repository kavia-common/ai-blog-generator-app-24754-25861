# Backend API Service - Environment Variables Example

# Server
BACKEND_PORT=8000

# Database (PostgreSQL)
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_blog_generator_db

# Authentication
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_MINUTES=1440

# CORS
# Comma-separated list of origins or ["*"] for all
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Provider
AI_PROVIDER=openai-compatible
AI_API_KEY= # set your OpenAI-compatible API key here
AI_MODEL=gpt-4o-mini

# PDF
PDF_ENGINE=placeholder
